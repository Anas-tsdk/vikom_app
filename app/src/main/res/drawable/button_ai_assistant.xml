<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/vk_secondary"
                android:centerColor="@color/vk_primary_pressed"
                android:endColor="@color/vk_primary_focus" />
            <stroke android:width="2dp" android:color="@color/vk_primary_focus" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/vk_secondary_pressed"
                android:centerColor="@color/vk_secondary"
                android:endColor="@color/vk_primary_pressed" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/vk_secondary"
                android:centerColor="@color/vk_primary_pressed"
                android:endColor="@color/vk_primary" />
            <corners android:radius="28dp" />
        </shape>
    </item>

</selector>
