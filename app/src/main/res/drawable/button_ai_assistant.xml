<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1A1A2E"
                android:centerColor="#3D4A7A"
                android:endColor="#6B7FBD" />
            <stroke android:width="2dp" android:color="#7986CB" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0F0F1E"
                android:centerColor="#2A3560"
                android:endColor="#4A5490" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1A1A2E"
                android:centerColor="#2E3A6E"
                android:endColor="#5C6BAE" />
            <corners android:radius="28dp" />
        </shape>
    </item>

</selector>
