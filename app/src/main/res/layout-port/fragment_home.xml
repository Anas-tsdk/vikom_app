<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vk_home_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_standard"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/padding_large">

        <LinearLayout
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/appointment_card_background"
            android:clickable="true"
            android:contentDescription="@string/home_all_appointments"
            android:focusable="true"
            android:nextFocusDown="@+id/tile_appointments"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <TextView
                android:id="@+id/txt_invitation_title"
                style="@style/VK.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/appointment_invitation_title"
                android:textColor="@color/vk_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_hero_eyebrow"
                style="@style/VK.Text.Body.Emphasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/vk_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_hero_time"
                    style="@style/VK.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="@dimen/hero_time_size" />

                <TextView
                    android:id="@+id/txt_hero_who"
                    style="@style/VK.Text.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/txt_hero_status"
                    style="@style/VK.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/status_chip_booked"
                    android:paddingHorizontal="@dimen/padding_standard"
                    android:paddingVertical="8dp"
                    android:textColor="@color/vk_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/hero_tasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <include layout="@layout/view_home_invitation_actions" />

            <TextView
                android:id="@+id/txt_hero_state"
                style="@style/VK.Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="@dimen/padding_large"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_appointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_standard"
            android:background="@drawable/appointment_card_background"
            android:clickable="true"
            android:contentDescription="@string/home_all_appointments"
            android:focusable="true"
            android:nextFocusUp="@id/hero_card"
            android:nextFocusDown="@+id/tile_contacts"
            android:nextFocusLeft="@id/tile_appointments"
            android:nextFocusRight="@id/tile_appointments"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <ImageView style="@style/VK.HomeTile.Icon" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_calendar" />
            <TextView style="@style/VK.HomeTile.Label" android:text="@string/home_all_appointments" />
            <TextView android:id="@+id/txt_tile_appointments_sub" style="@style/VK.HomeTile.Sub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_standard"
            android:background="@drawable/appointment_card_background"
            android:clickable="true"
            android:contentDescription="@string/home_call_someone"
            android:focusable="true"
            android:nextFocusUp="@id/tile_appointments"
            android:nextFocusDown="@+id/tile_care_team"
            android:nextFocusLeft="@id/tile_contacts"
            android:nextFocusRight="@id/tile_contacts"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <ImageView style="@style/VK.HomeTile.Icon" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_call" />
            <TextView style="@style/VK.HomeTile.Label" android:text="@string/home_call_someone" />
            <TextView android:id="@+id/txt_tile_contacts_sub" style="@style/VK.HomeTile.Sub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_care_team"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_standard"
            android:background="@drawable/appointment_card_background"
            android:clickable="true"
            android:contentDescription="@string/home_daily_tasks"
            android:focusable="true"
            android:nextFocusUp="@id/tile_contacts"
            android:nextFocusDown="@id/tile_care_team"
            android:nextFocusLeft="@id/tile_care_team"
            android:nextFocusRight="@id/tile_care_team"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <ImageView style="@style/VK.HomeTile.Icon" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_acc_daily" />
            <TextView style="@style/VK.HomeTile.Label" android:text="@string/home_daily_tasks" />
            <TextView android:id="@+id/txt_tile_care_team_sub" style="@style/VK.HomeTile.Sub" android:text="@string/ai_no_daily_tasks_short" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
