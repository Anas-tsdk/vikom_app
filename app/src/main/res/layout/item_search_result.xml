<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height"
    android:layout_marginBottom="6dp"
    android:background="@drawable/button_search_result_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="@dimen/padding_standard"
    android:focusable="true"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    tools:ignore="UnusedAttribute">

    <TextView
        android:id="@+id/search_result_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@android:color/white"
        android:textSize="@dimen/tab_text_size"
        android:ellipsize="end"
        android:maxLines="1"
        tools:ignore="TextContrastCheck"
        tools:text="@string/contact_name_placeholder" />

    <TextView
        android:id="@+id/search_result_contact_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_caption"
        android:layout_marginStart="@dimen/padding_medium"
        tools:ignore="TextContrastCheck"
        tools:text="@string/user_id_placeholder" />

</LinearLayout>
