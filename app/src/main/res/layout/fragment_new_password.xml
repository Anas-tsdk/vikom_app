<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/default_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/auth_padding">

        <TextView
            android:id="@+id/new_password_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_large"
            android:text="@string/new_password_title"
            android:textColor="#212121"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            android:accessibilityHeading="true"
            tools:ignore="UnusedAttribute" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="@dimen/input_max_width"
            android:maxWidth="@dimen/input_max_width"
            android:layout_marginBottom="@dimen/padding_standard">

            <TextView
                android:id="@+id/label_new_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_password_label"
                android:textSize="@dimen/text_primary"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/new_password_input" />

            <EditText
                android:id="@+id/new_password_input"
                tools:ignore="LabelFor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:background="@drawable/button_input_field"
                android:hint="@string/new_password_hint"
                android:inputType="textPassword"
                android:padding="@dimen/padding_standard"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_primary"
                android:importantForAutofill="yes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minWidth="@dimen/input_max_width"
            android:maxWidth="@dimen/input_max_width"
            android:layout_marginBottom="@dimen/padding_large">

            <TextView
                android:id="@+id/label_confirm_new_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_password_confirm_label"
                android:textSize="@dimen/text_primary"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/confirm_new_password_input" />

            <EditText
                android:id="@+id/confirm_new_password_input"
                tools:ignore="LabelFor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:background="@drawable/button_input_field"
                android:hint="@string/new_password_confirm_hint"
                android:inputType="textPassword"
                android:padding="@dimen/padding_standard"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_primary"
                android:importantForAutofill="yes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minWidth="@dimen/input_max_width"
            android:maxWidth="@dimen/input_max_width">

            <Button
                android:id="@+id/btn_save_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:stateListAnimator="@null"
                android:background="@drawable/button_primary"
                android:text="@string/new_password_save"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="@dimen/text_primary"
                android:padding="@dimen/padding_standard"
                tools:ignore="ButtonStyle,UnusedAttribute" />

            <Button
                android:id="@+id/btn_new_pass_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:stateListAnimator="@null"
                android:background="@drawable/button_secondary"
                android:text="@string/back_to_login"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="@dimen/text_primary"
                android:padding="@dimen/padding_standard"
                tools:ignore="ButtonStyle,UnusedAttribute" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
