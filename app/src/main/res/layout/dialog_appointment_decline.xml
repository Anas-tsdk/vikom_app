<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/dialog_width"
    android:background="@drawable/background_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dialog_padding_horizontal"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom">

    <TextView
        style="@style/VK.Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/appointment_decline_title"
        android:accessibilityHeading="true" />

    <TextView
        style="@style/VK.Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/appointment_decline_explanation" />

    <TextView
        android:id="@+id/btn_decline_suggest"
        android:nextFocusDown="@id/btn_decline_without_suggestion"
        android:nextFocusUp="@id/btn_decline_suggest"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/vk_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/dialog_button_height"
        android:paddingHorizontal="12dp"
        android:text="@string/appointment_suggest_time"
        android:textColor="@color/vk_white" />

    <TextView
        android:id="@+id/btn_decline_without_suggestion"
        android:nextFocusUp="@id/btn_decline_suggest"
        android:nextFocusDown="@id/btn_decline_cancel"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/vk_button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/dialog_button_height"
        android:paddingHorizontal="12dp"
        android:text="@string/appointment_decline_without_proposal"
        android:textColor="@color/vk_primary" />

    <TextView
        android:id="@+id/btn_decline_cancel"
        android:nextFocusUp="@id/btn_decline_without_suggestion"
        android:nextFocusDown="@id/btn_decline_cancel"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/dialog_button_height"
        android:text="@string/cancel"
        android:textColor="@color/vk_text_muted" />
</LinearLayout>
