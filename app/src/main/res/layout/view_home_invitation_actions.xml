<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/invitation_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/txt_invitation_prompt"
        style="@style/VK.Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/appointment_answer_prompt" />

    <TextView
        android:id="@+id/txt_invitation_progress"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/appointment_answering"
        android:textColor="@color/vk_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/invitation_response_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_home_invitation_decline"
            style="@style/VK.Text.Body.Emphasis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/vk_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_home_invitation_decline"
            android:nextFocusRight="@id/btn_home_invitation_accept"
            android:nextFocusUp="@id/header_left"
            android:nextFocusDown="@id/tile_appointments"
            android:gravity="center"
            android:minHeight="64dp"
            android:text="@string/appointment_decline"
            android:textColor="@color/vk_primary" />

        <TextView
            android:id="@+id/btn_home_invitation_accept"
            style="@style/VK.Text.Body.Emphasis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/vk_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_home_invitation_decline"
            android:nextFocusRight="@id/btn_home_invitation_accept"
            android:nextFocusUp="@id/header_left"
            android:nextFocusDown="@id/tile_appointments"
            android:gravity="center"
            android:minHeight="64dp"
            android:text="@string/appointment_accept"
            android:textColor="@color/vk_white" />
    </LinearLayout>
</LinearLayout>
