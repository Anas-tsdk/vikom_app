<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/dialog_width"
    android:background="@drawable/background_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dialog_padding_horizontal"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom">

    <TextView
        style="@style/VK.Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/appointment_suggest_time_title"
        android:accessibilityHeading="true" />

    <TextView
        style="@style/VK.Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/appointment_suggest_time_explanation" />

    <TextView
        android:id="@+id/btn_proposal_date"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/vk_button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/vk_primary" />

    <TextView
        android:id="@+id/btn_proposal_start"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/vk_button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/vk_primary" />

    <TextView
        android:id="@+id/btn_proposal_end"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/vk_button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/vk_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_proposal_cancel"
            style="@style/VK.Text.Body.Emphasis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/vk_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/dialog_button_height"
            android:text="@string/cancel"
            android:textColor="@color/vk_primary" />

        <TextView
            android:id="@+id/btn_proposal_send"
            style="@style/VK.Text.Body.Emphasis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/vk_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/dialog_button_height"
            android:text="@string/appointment_send_proposal"
            android:textColor="@color/vk_white" />
    </LinearLayout>
</LinearLayout>
