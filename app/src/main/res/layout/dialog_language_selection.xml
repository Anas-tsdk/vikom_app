<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/background_dialog"
    android:minWidth="320dp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dialog_padding_horizontal"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom">

    <TextView
        style="@style/VK.Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/language_dialog_title" />

    <TextView
        style="@style/VK.Text.Body.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/language_dialog_subtitle" />

    <LinearLayout
        android:id="@+id/language_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btn_language_cancel"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/vk_button_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/dialog_button_height"
        android:text="@string/cancel"
        android:textColor="@color/vk_primary" />
</LinearLayout>
