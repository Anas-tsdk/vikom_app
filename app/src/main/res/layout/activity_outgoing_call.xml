<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background_call_screen"
    tools:context=".ui.activities.OutgoingCallActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/padding_xlarge"
        android:paddingBottom="@dimen/padding_large"
        tools:ignore="ScrollViewSize">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txt_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_caller_name"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            tools:text="@string/unknown_contact"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/txt_contact_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_call_status"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_contact_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_call_secondary"
            android:textSize="@dimen/text_primary"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="@dimen/call_avatar_size"
            android:layout_height="@dimen/call_avatar_size"
            android:layout_marginTop="@dimen/padding_standard">

            <ImageView
                android:id="@+id/img_contact_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/call_avatar_circle"
                android:contentDescription="@string/content_desc_contact_avatar"
                android:scaleType="centerCrop"
                tools:ignore="ImageContrastCheck"
                tools:src="@drawable/call_avatar_circle" />

            <TextView
                android:id="@+id/txt_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/txt_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_ringing"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_call_status"
            android:layout_marginTop="@dimen/padding_standard"
            android:accessibilityLiveRegion="polite" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_hang_up"
                android:layout_width="@dimen/button_call_action"
                android:layout_height="@dimen/button_call_action"
                android:background="@drawable/button_call_hangup"
                android:src="@drawable/ic_call_end"
                android:scaleType="fitCenter"
                android:padding="@dimen/call_button_padding"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:defaultFocusHighlightEnabled="false"
                android:contentDescription="@string/content_desc_end_call"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/label_hang_up"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:importantForAccessibility="no" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
