<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/default_background"
    android:padding="@dimen/padding_xlarge">

    <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            tools:ignore="UnusedAttribute" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="@dimen/button_width"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/padding_standard"
            android:text="@string/home_title"
            android:textSize="@dimen/text_primary"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="6dp" />

    </LinearLayout>

    <ScrollView
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:clipToPadding="false"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/padding_xlarge"
        android:fillViewport="true">

        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/img_avatar"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginBottom="@dimen/padding_small"
                android:scaleType="centerCrop"
                android:contentDescription="@string/content_desc_profile_photo"
                android:background="@drawable/call_avatar_circle"
                android:focusable="false"
                android:clickable="false"
                tools:ignore="ImageContrastCheck"
                tools:src="@drawable/call_avatar_circle" />

            <TextView
                android:id="@+id/btn_change_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:layout_marginBottom="@dimen/padding_large"
                android:text="@string/change_photo"
                android:textSize="@dimen/text_primary"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_large"
                android:paddingVertical="@dimen/padding_small"
                android:background="@drawable/button_primary_grid"
                android:focusable="true"
                android:clickable="true"/>

            <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_primary"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:labelFor="@id/txt_username" />

                <TextView
                    android:id="@+id/txt_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_primary"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_medium"
                    android:background="@drawable/button_settings_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_edit_pencil"
                    android:drawableTint="@color/text_secondary" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
