<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/padding_xlarge">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="✓"
        android:textColor="@color/vk_primary"
        android:textSize="52sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/daily_check_in_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_standard"
        android:gravity="center"
        android:text="@string/daily_check_in_message"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_primary" />

    <TextView
        android:id="@+id/txt_check_in_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_standard"
        android:accessibilityLiveRegion="assertive"
        android:gravity="center"
        android:text="@string/daily_check_in_error"
        android:textColor="@color/color_mute_active"
        android:textSize="@dimen/text_primary"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/check_in_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_standard"
        android:indeterminate="true"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_confirm_daily_check_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:background="@drawable/vk_button_primary"
        android:focusable="true"
        android:minHeight="@dimen/button_height"
        android:padding="@dimen/padding_standard"
        android:stateListAnimator="@null"
        android:text="@string/daily_check_in_button"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_primary"
        android:textStyle="bold" />

</LinearLayout>
