<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/default_background"
    android:padding="@dimen/padding_xlarge" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_edit_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dialog_button_height"
                android:background="@drawable/button_favorite"
                android:focusable="true"
                android:clickable="true"
                android:gravity="center"
                android:text="@string/edit_contact"
                android:textSize="@dimen/text_primary"
                android:textColor="#FFFFFF"
                android:drawableStart="@drawable/ic_edit_pencil"
                android:drawableTint="#FFFFFF"
                android:drawablePadding="6dp"
                android:paddingHorizontal="@dimen/padding_large"
                android:paddingVertical="@dimen/padding_standard" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="@dimen/button_width"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/padding_standard"
            android:text="@string/go_back"
            android:textSize="@dimen/text_primary"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawablePadding="6dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/padding_xlarge"
        android:gravity="top|center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/contact_name_placeholder"
                android:textColor="#000000"
                android:textSize="@dimen/contact_detail_name"
                android:textStyle="bold"
                android:accessibilityHeading="true"
                android:importantForAccessibility="yes"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/contact_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/contact_detail_nickname"
                android:visibility="gone"
                tools:text="@string/contact_nickname_placeholder"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:id="@+id/img_contact_avatar"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/call_avatar_circle"
            android:contentDescription="@string/content_desc_contact_avatar"
            android:scaleType="centerCrop"
            android:layout_marginVertical="@dimen/padding_small"
            tools:src="@drawable/call_avatar_circle" />

        <TextView
            android:id="@+id/contact_online_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/status_checking"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/contact_detail_status" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_call_grid"
            android:gravity="center"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/padding_standard"
            android:orientation="horizontal"
            android:focusable="true"
            android:clickable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_call"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/call"
                android:textSize="@dimen/text_primary"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_video_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_call_grid"
            android:gravity="center"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/padding_standard"
            android:orientation="horizontal"
            android:focusable="true"
            android:clickable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_camera_on"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/video_call"
                android:textSize="@dimen/text_primary"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_view_messages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_primary_grid"
            android:gravity="center"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/padding_standard"
            android:orientation="horizontal"
            android:focusable="true"
            android:clickable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_email"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/view_messages"
                android:textSize="@dimen/text_primary"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_add_contact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_primary_grid"
            android:gravity="center"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/padding_standard"
            android:textSize="@dimen/text_primary"
            android:text="@string/add_to_contacts"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>