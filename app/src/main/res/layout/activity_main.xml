<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    tools:context=".ui.activities.MainActivity"
    tools:deviceIds="tv">

    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="@dimen/padding_xlarge"
        android:layout_marginTop="@dimen/header_top_margin"
        android:layout_marginBottom="@dimen/padding_large">

        <LinearLayout
            android:id="@+id/header_left"
            android:layout_width="@dimen/logo_width"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:contentDescription="@string/home_title"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="@dimen/logo_width"
                android:layout_height="@dimen/logo_height"
                android:src="@drawable/tv_caller_logo"
                android:scaleType="fitStart"
                android:contentDescription="@string/content_desc_logo" />

            <TextView
                android:id="@+id/txt_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/welcome_user"
                android:textSize="@dimen/header_welcome_text"
                android:textColor="@color/color_welcome_text" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/header_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/header_left"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/padding_standard"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <LinearLayout
                android:id="@+id/btn_hamburger_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/header_widget_container"
                android:paddingHorizontal="@dimen/padding_standard"
                android:paddingVertical="6dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_hamburger"
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:src="@drawable/ic_menu"
                    android:background="@drawable/button_header_icon"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/content_desc_menu"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_ai_assistant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/button_ai_assistant"
                android:paddingHorizontal="@dimen/padding_standard"
                android:paddingVertical="10dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btn_ai_assistant"
                android:contentDescription="@string/ai_assistant_button"
                tools:ignore="TouchTargetSizeCheck">

                <ImageView
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:adjustViewBounds="true"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ai_assistant_robot"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_assistant_button"
                    android:textSize="@dimen/text_primary"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/icons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/header_widget_container"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/padding_standard">

                <LinearLayout
                    android:id="@+id/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/button_setting_container"
                    android:paddingHorizontal="@dimen/padding_standard"
                    android:paddingVertical="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/settings_title"
                    tools:ignore="TouchTargetSizeCheck">

                    <ImageView
                        android:layout_width="@dimen/header_icon_size"
                        android:layout_height="@dimen/header_icon_size"
                        android:src="@drawable/ic_settings"
                        android:scaleType="fitCenter"
                        android:focusable="false"
                        android:clickable="false"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/txt_settings_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_title"
                        android:textSize="@dimen/text_primary"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/button_profile_container"
                    android:paddingHorizontal="@dimen/padding_standard"
                    android:paddingVertical="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@id/btn_profile"
                    android:contentDescription="@string/profile_title"
                    tools:ignore="TouchTargetSizeCheck">

                    <ImageView
                        android:layout_width="@dimen/header_icon_size"
                        android:layout_height="@dimen/header_icon_size"
                        android:src="@drawable/ic_profile"
                        android:scaleType="fitCenter"
                        android:focusable="false"
                        android:clickable="false"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/txt_profile_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_title"
                        android:textSize="@dimen/text_primary"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/clock_spacer"
                android:layout_width="@dimen/padding_standard"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/clock_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/header_widget_container"
                android:paddingHorizontal="@dimen/padding_standard"
                android:paddingVertical="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/header_icon_size"
                    android:layout_height="@dimen/header_icon_size"
                    android:src="@drawable/ic_clock"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/content_desc_clock"
                    tools:ignore="ImageContrastCheck" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/txt_clock_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/clock_time_size"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2dp"
                        tools:text="14:05" />

                    <TextView
                        android:id="@+id/txt_clock_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/clock_date_size"
                        android:textColor="@color/text_cancel_button"
                        tools:text="15/01/2026" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>
        </HorizontalScrollView>
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/main_browse_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar"/>

</RelativeLayout>
