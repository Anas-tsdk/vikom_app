<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/btn_screen_back"
        style="@style/VK.Text.Body.Emphasis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/vk_button_secondary"
        android:clickable="true"
        android:drawableStart="@drawable/ic_home"
        android:drawablePadding="10dp"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingHorizontal="@dimen/padding_standard"
        android:text="@string/home_title"
        android:textColor="@color/vk_primary" />

    <TextView
        android:id="@+id/txt_screen_title"
        style="@style/VK.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_standard"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
