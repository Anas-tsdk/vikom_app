<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_dialog"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom"
    android:paddingHorizontal="@dimen/dialog_padding_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/choose_avatar"
        android:textSize="@dimen/dialog_title_size"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/padding_large"
        android:accessibilityHeading="true"
        tools:ignore="UnusedAttribute" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:rowCount="2"
        android:columnCount="3"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/avatar_blue"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="4dp"
            android:src="@drawable/avatar_blue"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_avatar_selection_item"
            android:contentDescription="@string/avatar_blue" />

        <ImageView
            android:id="@+id/avatar_green"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="4dp"
            android:src="@drawable/avatar_green"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_avatar_selection_item"
            android:contentDescription="@string/avatar_green" />

        <ImageView
            android:id="@+id/avatar_red"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="4dp"
            android:src="@drawable/avatar_red"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_avatar_selection_item"
            android:contentDescription="@string/avatar_red" />

        <ImageView
            android:id="@+id/avatar_purple"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="4dp"
            android:src="@drawable/avatar_purple"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_avatar_selection_item"
            android:contentDescription="@string/avatar_purple" />

        <ImageView
            android:id="@+id/avatar_orange"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="4dp"
            android:src="@drawable/avatar_orange"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_avatar_selection_item"
            android:contentDescription="@string/avatar_orange" />

        <ImageView
            android:id="@+id/avatar_teal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="4dp"
            android:src="@drawable/avatar_teal"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_avatar_selection_item"
            android:contentDescription="@string/avatar_teal" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/padding_large">

        <Button
            android:id="@+id/btn_remove_avatar"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_danger"
            android:focusable="true"
            android:clickable="true"
            android:stateListAnimator="@null"
            android:text="@string/remove_photo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_primary"
            android:textStyle="bold"
            tools:ignore="ButtonStyle,ButtonTooWide" />

        <Button
            android:id="@+id/btn_done_avatar"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/button_secondary"
            android:focusable="true"
            android:clickable="true"
            android:stateListAnimator="@null"
            android:text="@string/done"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_primary"
            android:textStyle="bold"
            tools:ignore="ButtonStyle,ButtonTooWide" />

    </LinearLayout>

</LinearLayout>
