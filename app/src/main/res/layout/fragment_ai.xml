<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vk_home_background"
    android:orientation="vertical"
    android:padding="@dimen/padding_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/VK.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/ai_assistant_page"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/btn_ai_confirm"
            style="@style/VK.Text.Body.Emphasis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vk_button_secondary"
            android:clickable="true"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp"
            android:paddingHorizontal="@dimen/padding_standard"
            android:text="@string/home_title"
            android:textColor="@color/vk_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/padding_standard"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/padding_standard"
            android:layout_weight="0.86"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:maxHeight="150dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai_assistant_full" />

            <TextView
                android:id="@+id/txt_ai_greeting"
                style="@style/VK.Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                tools:ignore="UnusedAttribute" />

            <TextView
                style="@style/VK.Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/ai_subtitle" />

            <LinearLayout
                android:id="@+id/card_head_nurse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:background="@drawable/appointment_card_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="80dp"
                android:orientation="horizontal"
                android:padding="@dimen/padding_standard">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_acc_doctor" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/VK.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_head_nurse_title"
                        android:textColor="@color/vk_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_head_nurse_name"
                        style="@style/VK.Text.Body.Emphasis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/txt_head_nurse_phone"
                        style="@style/VK.Text.Body.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.14"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include layout="@layout/view_help_tile_medicine" />

                <Space android:layout_width="12dp" android:layout_height="match_parent" />

                <include layout="@layout/view_help_tile_appointments" />
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include layout="@layout/view_help_tile_daily" />

                <Space android:layout_width="12dp" android:layout_height="match_parent" />

                <include layout="@layout/view_help_tile_emergency" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
