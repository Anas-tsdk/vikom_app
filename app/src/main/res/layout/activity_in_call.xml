<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_call_screen"
    tools:context=".ui.activities.InCallActivity">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/padding_xlarge"
        android:paddingBottom="@dimen/padding_large">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/call_info_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txt_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caller_name"
                android:textStyle="bold"
                android:accessibilityHeading="true"
                tools:text="Contact Name"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/txt_contact_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_call_status"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_connected"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_call_status"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:accessibilityLiveRegion="polite" />

            <FrameLayout
                android:layout_width="@dimen/call_avatar_size"
                android:layout_height="@dimen/call_avatar_size"
                android:layout_marginTop="@dimen/padding_standard">

                <ImageView
                    android:id="@+id/img_contact_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/call_avatar_circle"
                    android:contentDescription="@string/content_desc_contact_avatar"
                    android:scaleType="centerCrop"
                    tools:ignore="ImageContrastCheck"
                    tools:src="@drawable/call_avatar_circle" />

                <TextView
                    android:id="@+id/txt_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/txt_call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:text="@string/call_timer_default"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_call_timer" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txt_video_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_medium"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_caller_name"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Contact Name" />

        <TextView
            android:id="@+id/txt_mute_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_medium"
            android:text="@string/muted"
            android:textColor="@color/color_mute_active"
            android:textSize="@dimen/text_primary"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/call_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/call_controls_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:contentDescription="@string/call_controls_group"
            android:importantForAccessibility="yes"
            android:screenReaderFocusable="true"
            tools:ignore="UnusedAttribute">

            <LinearLayout
                android:layout_width="@dimen/button_call_action"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_mute"
                    android:layout_width="@dimen/button_call_action"
                    android:layout_height="@dimen/button_call_action"
                    android:background="@drawable/button_call_action_blue"
                    android:src="@drawable/ic_mic"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/call_button_padding"
                    android:stateListAnimator="@null"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_mute"
                    android:nextFocusRight="@+id/btn_speaker"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/content_desc_mute"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/txt_mute_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/label_mute"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/button_call_action"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@id/btn_speaker"
                    android:layout_width="@dimen/button_call_action"
                    android:layout_height="@dimen/button_call_action"
                    android:background="@drawable/button_call_action_blue"
                    android:src="@drawable/ic_speaker_on"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/call_button_padding"
                    android:stateListAnimator="@null"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_mute"
                    android:nextFocusRight="@id/btn_hang_up"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/content_desc_speaker"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/txt_speaker_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/label_speaker"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/button_call_action"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_hang_up"
                    android:layout_width="@dimen/button_call_action"
                    android:layout_height="@dimen/button_call_action"
                    android:background="@drawable/button_call_hangup"
                    android:src="@drawable/ic_call_end"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/call_button_padding"
                    android:stateListAnimator="@null"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_speaker"
                    android:nextFocusRight="@id/btn_camera"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/content_desc_end_call"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/label_hang_up"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/button_call_action"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_camera"
                    android:layout_width="@dimen/button_call_action"
                    android:layout_height="@dimen/button_call_action"
                    android:background="@drawable/button_call_action_blue"
                    android:src="@drawable/ic_camera_on"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/call_button_padding"
                    android:stateListAnimator="@null"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_hang_up"
                    android:nextFocusRight="@+id/btn_switch_camera"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/content_desc_camera_on"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/txt_camera_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/label_start_video"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/switch_camera_control"
                android:layout_width="@dimen/button_call_action"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@id/btn_switch_camera"
                    android:layout_width="@dimen/button_call_action"
                    android:layout_height="@dimen/button_call_action"
                    android:background="@drawable/button_call_action_blue"
                    android:src="@drawable/ic_switch_camera"
                    android:scaleType="fitCenter"
                    android:padding="@dimen/call_button_padding"
                    android:stateListAnimator="@null"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_camera"
                    android:nextFocusRight="@id/btn_switch_camera"
                    android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/content_desc_switch_camera"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/label_switch_camera"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_caption"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txt_video_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/padding_standard"
        android:background="#66000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/call_timer_default"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_call_timer"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/local_video_surface"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/padding_standard"
        android:visibility="gone"
        android:importantForAccessibility="no"
        tools:visibility="visible" />


</FrameLayout>
