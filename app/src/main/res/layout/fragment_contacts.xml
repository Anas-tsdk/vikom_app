<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/padding_large"
    android:paddingTop="@dimen/spacing_small"
    android:paddingBottom="@dimen/spacing_xsmall">

    <include layout="@layout/view_screen_header" />

    <LinearLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_quick_dial"
            android:paddingHorizontal="@dimen/padding_standard"
            android:paddingVertical="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_quick_dial"
            android:textSize="@dimen/text_primary"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/tab_button_first_inactive"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false"
            android:layout_marginEnd="@dimen/padding_small"
            tools:ignore="UnusedAttribute,TextContrastCheck" />

        <TextView
            android:id="@+id/tab_contacts"
            android:paddingHorizontal="@dimen/padding_standard"
            android:paddingVertical="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_contacts"
            android:textSize="@dimen/text_primary"
            android:textColor="#E8F5E9"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/tab_button_last_active"
            android:focusable="true"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false"
            android:layout_marginStart="@dimen/padding_small"
            android:accessibilityHeading="true"
            tools:ignore="UnusedAttribute,TextContrastCheck" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/background_content_area"
        android:paddingHorizontal="@dimen/padding_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/padding_small">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/background_search_input">

                <ImageView
                    android:layout_width="@dimen/search_icon_size"
                    android:layout_height="@dimen/search_icon_size"
                    android:src="@drawable/ic_search_icon"
                    android:scaleType="center"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/text_secondary"
                    android:background="@android:color/transparent"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:nextFocusDown="@id/contacts_list"
                    tools:ignore="VisualLintTextFieldSize,HardcodedText,Autofill,NestedWeights" />

                <TextView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="@dimen/search_clear_btn_size"
                    android:layout_height="@dimen/search_clear_btn_size"
                    android:text="✕"
                    android:textSize="@dimen/tab_text_size"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:visibility="gone"
                    tools:ignore="HardcodedText,UnusedAttribute" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Søk Kontakt"
                android:textSize="@dimen/search_button_text"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:paddingHorizontal="@dimen/search_button_padding_horizontal"
                android:background="@drawable/button_primary_grid"
                android:focusable="true"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:layout_marginStart="@dimen/padding_small"
                tools:ignore="HardcodedText,UnusedAttribute,TextContrastCheck" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contacts_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            tools:ignore="NestedWeights" />

    </LinearLayout>

</LinearLayout>
